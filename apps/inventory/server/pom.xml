<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chetana.keystone</groupId>
        <artifactId>inventory</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>inventory-server</artifactId>
    <name>inventory-server</name>
    <description>Inventory backend service (built on the Keystone platform).</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.chetana.keystone</groupId>
                <artifactId>keystone-bom</artifactId>
                <version>${project.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- platform -->
        <dependency>
            <groupId>com.chetana.keystone</groupId>
            <artifactId>keystone-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chetana.keystone</groupId>
            <artifactId>keystone-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chetana.keystone</groupId>
            <artifactId>keystone-data</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chetana.keystone</groupId>
            <artifactId>keystone-realtime</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chetana.keystone</groupId>
            <artifactId>keystone-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chetana.keystone</groupId>
            <artifactId>keystone-observability</artifactId>
        </dependency>
        <dependency>
            <groupId>com.chetana.keystone</groupId>
            <artifactId>keystone-admin</artifactId>
        </dependency>

        <!-- config (YAML) -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>

        <!-- runtime -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- test -->
        <dependency>
            <groupId>com.chetana.keystone</groupId>
            <artifactId>keystone-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Delete Liquibase's offline DATABASECHANGELOG so codegen re-renders deterministically. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>clean-liquibase-offline-state</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete file="${maven.multiModuleProjectDirectory}/databasechangelog.csv" quiet="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Offline jOOQ codegen (docs/ARCHITECTURE.md §6.2):
              1. Liquibase renders THIS app's changelog to DDL (offline, no live DB).
              2. jOOQ's DDLDatabase generates app-specific sources from that DDL.
            -->
            <plugin>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-maven-plugin</artifactId>
                <configuration>
                    <changeLogFile>src/main/resources/db/changelog/db.changelog-master.xml</changeLogFile>
                    <url>offline:postgresql</url>
                    <migrationSqlOutputFile>${project.build.directory}/generated-ddl/schema.sql</migrationSqlOutputFile>
                    <defaultSchemaName>inventory</defaultSchemaName>
                    <outputDefaultSchema>true</outputDefaultSchema>
                </configuration>
                <executions>
                    <execution>
                        <id>render-schema-ddl</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>updateSQL</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jooq</groupId>
                <artifactId>jooq-codegen-maven</artifactId>
                <executions>
                    <execution>
                        <id>jooq-codegen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.jooq</groupId>
                        <artifactId>jooq-meta-extensions</artifactId>
                        <version>${jooq.version}</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <generator>
                        <database>
                            <name>org.jooq.meta.extensions.ddl.DDLDatabase</name>
                            <skipRegenerationOnUpToDateVersion>false</skipRegenerationOnUpToDateVersion>
                            <properties>
                                <property>
                                    <key>scripts</key>
                                    <value>${project.build.directory}/generated-ddl/schema.sql</value>
                                </property>
                                <property>
                                    <key>dialect</key>
                                    <value>POSTGRES</value>
                                </property>
                                <property>
                                    <key>defaultNameCase</key>
                                    <value>lower</value>
                                </property>
                            </properties>
                        </database>
                        <generate>
                            <javaTimeTypes>true</javaTimeTypes>
                        </generate>
                        <target>
                            <packageName>com.chetana.keystone.inventory.jooq</packageName>
                            <directory>${project.build.directory}/generated-sources/jooq</directory>
                        </target>
                    </generator>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>${build-helper-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <id>add-jooq-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/jooq</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Cloud Run container image (docs/ARCHITECTURE.md §7.2). -->
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <configuration>
                    <from>
                        <image>eclipse-temurin:25-jre</image>
                    </from>
                    <to>
                        <image>${jib.to.image}</image>
                        <tags>
                            <tag>${project.version}</tag>
                        </tags>
                    </to>
                    <container>
                        <mainClass>com.chetana.keystone.inventory.Main</mainClass>
                        <jvmFlags>
                            <jvmFlag>-XX:+UseZGC</jvmFlag>
                            <!-- Guice 7.0.0 (latest) triggers a terminally-deprecated
                                 sun.misc.Unsafe::staticFieldBase warning on JDK 25; see google/guice#1909. -->
                            <jvmFlag>--sun-misc-unsafe-memory-access=allow</jvmFlag>
                        </jvmFlags>
                        <ports>
                            <port>8080</port>
                        </ports>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
