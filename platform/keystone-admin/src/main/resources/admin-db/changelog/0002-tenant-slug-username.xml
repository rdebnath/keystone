<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="0002-tenant-slug-username" author="keystone">
        <!-- Idempotency guard: local docker init (docker/initdb/init.sql) may have already applied this. -->
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="tenants" columnName="slug"/>
            </not>
        </preConditions>
        <addColumn tableName="tenants">
            <column name="slug" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addUniqueConstraint tableName="tenants" columnNames="slug" constraintName="uq_tenants_slug"/>

        <addColumn tableName="users">
            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addUniqueConstraint tableName="users" columnNames="username, tenant_id" constraintName="uq_users_username_tenant"/>
    </changeSet>
</databaseChangeLog>
